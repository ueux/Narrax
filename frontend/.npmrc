# pnpm settings.
# node-linker=hoisted produces a flat node_modules (like npm/yarn) which is the most
# robust layout for Next.js on Windows, avoiding junction-resolution issues.
node-linker=hoisted

# Keep the content-addressable store inside the project so installs are hermetic and
# do not depend on the user's global store. (`.pnpm-store/` is gitignored.)
store-dir=.pnpm-store
