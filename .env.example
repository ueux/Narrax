# =====================================================================
# NarraX environment template.
# Copy to `.env` and fill in values. Never commit `.env`.
# =====================================================================

# --- Application ---
NARRAX_ENV=development
API_V1_PREFIX=/api/v1

# --- Database (matches docker-compose.yml defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=narrax
POSTGRES_USER=narrax
POSTGRES_PASSWORD=narrax_dev_password
# SQLAlchemy URL used by the backend.
DATABASE_URL=postgresql+psycopg://narrax:narrax_dev_password@localhost:5432/narrax

# --- LLM (provider-independent; populated in the narrative-extraction phase) ---
# Supported values will be mapped through a provider adapter (e.g. openai, anthropic,
# gemini, ollama, ...). Leave blank to disable LLM features.
LLM_PROVIDER=
LLM_API_KEY=

# --- Reddit ingestion (Phase 1) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=narrax-dev/0.1
